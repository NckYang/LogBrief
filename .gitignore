# Publish compression code, MCP examples, README and recorded Gemini evidence.
/*
!/.gitignore
!/README.md
!/GEMINI_DIAGNOSIS.md
!/AI_COLLABORATION.md
!/pyproject.toml
!/logbrief/
!/examples/
!/.codex/
!/reports/

# Report sources and only the evidence cited by the report.
/reports/*
!/reports/README.md
!/reports/LogBrief_HW2_Report.md
!/reports/export_report.py
!/reports/requirements-report.txt
!/reports/evidence/
/reports/evidence/*
!/reports/evidence/README.md
!/reports/evidence/current_demo_report.json
!/reports/evidence/selection_ablation.json
!/reports/evidence/unit-tests.txt

/.codex/*
!/.codex/config.toml

/logbrief/*
!/logbrief/__init__.py
!/logbrief/__main__.py
!/logbrief/cli.py
!/logbrief/compressor.py
!/logbrief/prompts.py
!/logbrief/tokens.py
!/logbrief/mcp_server.py

/examples/*
!/examples/training.log
!/examples/compression_demo.py
